# CPack uses the same install rules as a normal native installation.
set(DRIVONIX_PACKAGE_VERSION "0.0.0-dev" CACHE STRING "Package version, without a leading v")
set(DRIVONIX_PACKAGE_COMMIT "" CACHE STRING "Source commit recorded in packages")
set(DRIVONIX_PACKAGE_BUILD_OS "${CMAKE_SYSTEM_NAME}" CACHE STRING "Build operating system")
if(NOT DRIVONIX_PACKAGE_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$")
    message(FATAL_ERROR "Invalid DRIVONIX_PACKAGE_VERSION")
endif()
if(NOT DRIVONIX_PACKAGE_COMMIT)
    find_package(Git QUIET)
    if(GIT_FOUND)
        execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
            WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" OUTPUT_VARIABLE DRIVONIX_PACKAGE_COMMIT
            OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    endif()
    if(NOT DRIVONIX_PACKAGE_COMMIT)
        set(DRIVONIX_PACKAGE_COMMIT "unknown")
    endif()
endif()
if(NOT DRIVONIX_PACKAGE_COMMIT MATCHES "^[0-9a-fA-F]+$" AND NOT DRIVONIX_PACKAGE_COMMIT STREQUAL "unknown")
    message(FATAL_ERROR "Invalid DRIVONIX_PACKAGE_COMMIT")
endif()
string(TOLOWER "${CMAKE_SYSTEM_NAME}" DRIVONIX_PACKAGE_PLATFORM)
set(package_arch "${CMAKE_SYSTEM_PROCESSOR}")
if(package_arch MATCHES "^(AMD64|amd64|x86_64)$")
    set(package_arch "x86_64")
endif()
if(WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL 4)
    set(package_arch "x86")
endif()
configure_file("${CMAKE_SOURCE_DIR}/cmake/build-info.json.in" "${CMAKE_BINARY_DIR}/build-info.json" @ONLY)
install(FILES "${CMAKE_SOURCE_DIR}/README.md" "${CMAKE_BINARY_DIR}/build-info.json"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/drivonix")

if(WIN32)
    # Include the redistributable compiler runtimes, rather than relying on
    # Visual Studio being present on the recipient's machine.
    if(MSVC)
        set(CMAKE_INSTALL_SYSTEM_RUNTIME_DESTINATION "${CMAKE_INSTALL_BINDIR}")
        include(InstallRequiredSystemLibraries)
    endif()
    if(CSFML_ROOT)
        install(DIRECTORY "${CSFML_ROOT}/bin/" DESTINATION "${CMAKE_INSTALL_BINDIR}"
            FILES_MATCHING PATTERN "*.dll")
        install(DIRECTORY "${CSFML_ROOT}/licenses/"
            DESTINATION "${CMAKE_INSTALL_DATADIR}/drivonix/licenses")
    endif()
    set(CPACK_GENERATOR "ZIP")
else()
    set(CPACK_GENERATOR "TGZ;DEB")
    set(CPACK_DEBIAN_PACKAGE_NAME "drivonix")
    set(CPACK_DEBIAN_PACKAGE_MAINTAINER "DrivOnix contributors")
    set(CPACK_DEBIAN_PACKAGE_SECTION "games")
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
    # Debian prereleases must sort before their corresponding stable version.
    string(REGEX REPLACE "^([0-9]+\\.[0-9]+\\.[0-9]+)-" "\\1~"
        CPACK_DEBIAN_PACKAGE_VERSION "${DRIVONIX_PACKAGE_VERSION}")
endif()
set(CPACK_PACKAGE_NAME "DrivOnix")
set(CPACK_PACKAGE_VENDOR "DrivOnix contributors")
set(CPACK_PACKAGE_VERSION "${DRIVONIX_PACKAGE_VERSION}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Sega Mega Drive / Genesis emulator")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/acceleratorlastorder/DrivOnix-Genesis_Megadrive_Emulator")
set(CPACK_PACKAGE_FILE_NAME "DrivOnix-${DRIVONIX_PACKAGE_VERSION}-${DRIVONIX_PACKAGE_PLATFORM}-${package_arch}")
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY ON)
set(CPACK_PROJECT_CONFIG_FILE "${CMAKE_SOURCE_DIR}/cmake/PackageLayout.cmake")
include(CPack)
